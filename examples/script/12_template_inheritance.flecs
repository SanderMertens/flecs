// This script shows how a template can inherit behavior from another template.
// When a template inherits from another template, the body of the base is
// instantiated before the body of the derived template, and the body of the
// derived template can read and assign the muts of the base.
//
// This makes it possible to write a "headless" template that only implements
// the behavior of a widget, with derived templates that provide the visuals.

using flecs.script

struct Position(x: f32, y: f32)
struct Rect(width: f32, height: f32)
struct Rgb(r: u8, g: u8, b: u8)
struct Text(value: string, size: i32, align: string)

const panelColor: Rgb = {46, 50, 58}
const panelDarkColor: Rgb = {32, 35, 41}
const accentColor: Rgb = {98, 168, 122}
const textColor: Rgb = {214, 218, 224}
const hoverColor: Rgb = {60, 65, 75}
const fontSize = 12

// The base template. It has no visuals of its own, it only keeps track of how
// the mouse interacts with the widget.
template HeadlessButton {
  prop label: string = "Button"
  prop width = 140
  prop height = 32

  mut hover = false
  mut active = false

  async {
    while true {
      await on.enter(this)
      hover = true
      await on.leave(this)
      hover = false
      active = false
    }
  }

  async {
    while true {
      await on.press(this)
      active = true
      await on.release(this)
      active = false
    }
  }
}

// A button that draws itself with the state of HeadlessButton. The body is
// reevaluated whenever hover or active changes.
template Button : HeadlessButton {
  prop color: Rgb = accentColor

  bg {
    Position: {}
    Rect: {width, height}

    if active {
      Rgb: color
    } else if hover {
      Rgb: hoverColor
    } else {
      Rgb: panelColor
    }
  }

  caption {
    Position: {y: -1}
    Text: {label, fontSize, "center"}
    Rgb: textColor
  }
}

// A button that uses the same behavior, but draws an underline instead of
// changing the color of its background.
template UnderlineButton : HeadlessButton {
  prop color: Rgb = accentColor

  bg {
    Position: {}
    Rect: {width, height}
    Rgb: panelDarkColor
  }

  caption {
    Position: {y: -1}

    if hover {
      Text: {label, fontSize, "center"}
      Rgb: color
    } else {
      Text: {label, fontSize, "center"}
      Rgb: textColor
    }
  }

  if hover {
    underline {
      Position: {y: height / 2 - 4}
      Rect: {width - 16, 2}
      Rgb: color
    }
  }
}

// Inheritance can be chained. IconButton inherits the behavior of
// HeadlessButton and the visuals of Button, and only overrides the parts that
// are different. Because the body of Button runs first, the components it
// assigned can be overwritten.
template IconButton : Button {
  prop label: string = "+"

  bg {
    Rect: {height, height}
  }
}

Button save_button(label: "Save") {
  Position: {0, -40}
}

UnderlineButton cancel_button(label: "Cancel") {
  Position: {0, 0}
}

IconButton add_button {
  Position: {0, 40}
}
