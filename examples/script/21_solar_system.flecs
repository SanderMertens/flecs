using flecs.script

struct Position(x: f32, y: f32, z: f32)
struct Sphere(radius: f32)
struct Rgb(r: u8, g: u8, b: u8)

struct Size(radius: {f64, unit: flecs.units.Length.KiloMeters})
struct Mass(value: {f64, unit: flecs.units.Mass.KiloGrams})
struct Orbit(
  semi_major_axis: {f64, unit: flecs.units.Length.KiloMeters},
  period: {f64, unit: flecs.units.Duration.Days},
  eccentricity: f64,
  inclination: {f64, unit: flecs.units.Angle.Degrees}
)

const scale = 0.02
const minVisualRadius = 0.1
const days = 1000

const mercury: Rgb = {140, 136, 132}
const venus: Rgb = {226, 200, 150}
const earth: Rgb = {64, 110, 190}
const mars: Rgb = {193, 86, 52}
const jupiter: Rgb = {214, 176, 138}
const saturn: Rgb = {226, 202, 150}
const uranus: Rgb = {172, 218, 226}
const neptune: Rgb = {72, 108, 210}

const ceres: Rgb = {130, 125, 120}
const pluto: Rgb = {210, 180, 150}
const haumea: Rgb = {235, 235, 235}
const makemake: Rgb = {200, 140, 110}
const eris: Rgb = {238, 238, 234}

const moon: Rgb = {170, 168, 165}
const phobos: Rgb = {105, 95, 88}
const deimos: Rgb = {140, 125, 110}
const io: Rgb = {232, 208, 96}
const europa: Rgb = {222, 206, 178}
const ganymede: Rgb = {150, 138, 124}
const callisto: Rgb = {98, 88, 78}
const amalthea: Rgb = {168, 92, 62}
const mimas: Rgb = {190, 188, 184}
const enceladus: Rgb = {250, 250, 250}
const tethys: Rgb = {236, 236, 232}
const dione: Rgb = {214, 212, 208}
const rhea: Rgb = {200, 198, 192}
const titan: Rgb = {222, 164, 72}
const hyperion: Rgb = {182, 160, 130}
const iapetus: Rgb = {150, 132, 112}
const phoebe: Rgb = {62, 58, 54}
const miranda: Rgb = {186, 186, 184}
const ariel: Rgb = {204, 202, 200}
const umbriel: Rgb = {108, 106, 104}
const titania: Rgb = {172, 166, 160}
const oberon: Rgb = {150, 142, 136}
const triton: Rgb = {226, 208, 198}
const nereid: Rgb = {160, 158, 156}
const proteus: Rgb = {92, 90, 88}
const charon: Rgb = {150, 140, 135}
const dysnomia: Rgb = {70, 66, 62}

const ice: Rgb = {220, 220, 214}
const rock: Rgb = {128, 120, 112}
const redRock: Rgb = {150, 108, 88}
const darkRock: Rgb = {84, 80, 76}

template Body {
  prop radius: f64 = 0
  prop mass: f64 = 0
  prop orbit: Orbit = {}
  prop color: Rgb = {}

  const angle = 2 * math.PI * days / orbit.period
  const tilt = orbit.inclination * math.PI / 180
  const distance = scale * math.sqrt(orbit.semi_major_axis)

  Size: {radius}
  Mass: {mass}
  Orbit: orbit
  Rgb: color
  Sphere: {math.max(scale * math.sqrt(radius), minVisualRadius)}
  Position: {
    distance * math.cos(angle),
    distance * math.sin(angle) * math.sin(tilt),
    distance * math.sin(angle) * math.cos(tilt)
  }
}

template Planet : Body { }
template DwarfPlanet : Body { }
template Satellite : Body { }

