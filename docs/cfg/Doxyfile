# Doxyfile for the Flecs documentation website (Doxygen 1.18).
#
# Only settings that differ from the Doxygen defaults are listed. Run
# `docs/build.sh` from the repository root to build the site; it invokes
# Doxygen with this file and then runs `docs/cfg/postprocess.py`, which
# generates the sidebar navigation and the full-text search index.
#
# To add a manual: create docs/YourManual.md, add it to INPUT below, and add an
# entry for it to docs/cfg/nav.json.
#
# docs/examples is generated by docs/cfg/examples.py from the examples folder.

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = Flecs
PROJECT_NUMBER         = v4.1
PROJECT_BRIEF          = "A fast entity component system (ECS) for C & C++"
PROJECT_ICON           = docs/img/logo_small.png
OUTPUT_DIRECTORY       = docs
NUM_PROC_THREADS       = 0

JAVADOC_AUTOBRIEF      = YES
MARKDOWN_ID_STYLE      = GITHUB
TOC_INCLUDE_HEADINGS   = 5
CASE_SENSE_NAMES       = YES
SHOW_HEADERFILE        = YES
TIMESTAMP              = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_FORMAT            = "$file:$line: $text"

INPUT                  = include/flecs.h \
                         include/flecs/os_api.h \
                         include/flecs/addons \
                         README.md \
                         docs/Docs.md \
                         docs/FAQ.md \
                         docs/Quickstart.md \
                         docs/Playground.md \
                         docs/BuildingFlecs.md \
                         docs/DesignWithFlecs.md \
                         docs/EntitiesComponents.md \
                         docs/HierarchiesManual.md \
                         docs/Queries.md \
                         docs/FlecsQueryLanguage.md \
                         docs/Systems.md \
                         docs/ObserversManual.md \
                         docs/PrefabsManual.md \
                         docs/ComponentTraits.md \
                         docs/Relationships.md \
                         docs/FlecsScript.md \
                         docs/FlecsRemoteApi.md \
                         docs/Manual.md \
                         docs/MigrationGuide.md \
                         docs/examples
FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.inl \
                         *.md
RECURSIVE              = YES
IMAGE_PATH             = docs/img
EXAMPLE_PATH           = examples
EXAMPLE_PATTERNS       = *.c \
                         *.cpp \
                         *.h \
                         *.hpp
EXAMPLE_RECURSIVE      = YES
USE_MDFILE_AS_MAINPAGE = README.md

SOURCE_BROWSER         = YES
STRIP_CODE_COMMENTS    = NO

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_HEADER            = docs/cfg/header.html
HTML_FOOTER            = docs/cfg/footer.html
HTML_EXTRA_STYLESHEET  = docs/cfg/flecs.css
HTML_EXTRA_FILES       = docs/cfg/flecs.js \
                         docs/playground/playground.js \
                         docs/playground/playground.css \
                         docs/playground/ace-flecs-script.js \
                         docs/playground/ace-flecs-script-theme.js \
                         docs/examples/playground-examples.js \
                         docs/img/logo_small.png \
                         docs/img/logo_small_dark.png
HTML_COLORSTYLE        = TOGGLE
HTML_DYNAMIC_MENUS     = NO
HTML_CODE_FOLDING      = NO
HTML_COPY_CLIPBOARD    = NO
DISABLE_INDEX          = YES
GENERATE_TREEVIEW      = NO
SEARCHENGINE           = NO
OBFUSCATE_EMAILS       = YES
GENERATE_TAGFILE       = docs/html/flecs.tag

GENERATE_LATEX         = NO

MACRO_EXPANSION        = YES
PREDEFINED             = FLECS_APP \
                         FLECS_CACHED_QUERIES \
                         FLECS_CONSTRAINT_TRAITS \
                         FLECS_CPP \
                         FLECS_DOC \
                         FLECS_ENTITY_RANGES \
                         FLECS_FRAME \
                         FLECS_HTTP \
                         FLECS_JOURNAL \
                         FLECS_JSON \
                         FLECS_LOG \
                         FLECS_META \
                         FLECS_MODULE \
                         FLECS_MULTI_WORLD \
                         FLECS_OS_API_IMPL \
                         FLECS_PARSER \
                         FLECS_PIPELINE \
                         FLECS_PREFAB \
                         FLECS_QUERY_DSL \
                         FLECS_QUERY_PLANS \
                         FLECS_SCRIPT \
                         FLECS_REST \
                         FLECS_STATS \
                         FLECS_SYSTEM \
                         FLECS_TIMER \
                         FLECS_UNITS \
                         FLECS_ALERTS \
                         FLECS_METRICS

HAVE_DOT               = NO
CLASS_GRAPH            = NO
